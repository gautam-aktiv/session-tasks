<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_item_form_view_ak_sales_bulk_discount" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.inherit.ak_sales_bulk_discount</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_rule_method']" position="inside">
                <label for="sales_bulk_disc" invisible="compute_price != 'percentage'"/>
                <div class="o_row gap-3" invisible="compute_price != 'percentage'">
                    <field name="sales_bulk_disc"/>
                    <span>%</span>
                    <span>on</span>
                    <field name="base_pricelist_id" placeholder="sales price"/>
                </div>
            </xpath>
            <xpath expr="//group[@name='pricelist_rule_base']/group/div" position="after">
                <label for="sales_bulk_disc" invisible="compute_price != 'formula'"/>
                <div class="o_row" invisible="compute_price != 'formula'" style="width: 40% !important;">
                    <field name="sales_bulk_disc"/>
                    <span>%</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
