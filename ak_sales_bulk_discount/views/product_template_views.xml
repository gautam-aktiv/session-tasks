<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_inherit_ak_sales_bulk_discount" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.ak_sales_bulk_discount</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']//group[@name='upsell']" position="replace">
                <group string="Upsell, Cross-Sell &amp; Bulk Qty" name="upsell">
                    <field name="sales_bulk_qty"/>
                    <field name="apply_bulk_disc"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
